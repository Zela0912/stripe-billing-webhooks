# Copy to .env and fill in. .env is git-ignored.

# Stripe Dashboard → your sandbox → Developers → API keys → Secret key (sk_test_…).
# For a deployment, prefer a restricted key (rk_…) with only the permissions this app uses.
STRIPE_SECRET_KEY=

# Signing secret of the webhook endpoint. `npm run stripe:setup` fills in the local one
# (from the Stripe CLI). For a deployment it saves the endpoint's secret to .env.production.local.
STRIPE_WEBHOOK_SECRET=

# Demo mode: every visitor gets their own workspace on a Stripe test clock, plus the demo
# controls (failing card, advance to renewal). Refused with live keys.
DEMO_MODE=true

# Public URL of the web app; Checkout and the Customer Portal redirect back here.
# APP_URL=http://localhost:5174

# Requests per minute per IP on the billing endpoints (webhooks are not limited).
# RATE_LIMIT_PER_MINUTE=30

# Number of reverse proxies in front of the app (1 on Render, Fly.io, Railway).
# TRUST_PROXY=0

# PORT=3002
# DB_PATH=data/billing.db
