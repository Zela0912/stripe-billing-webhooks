{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/index.ts",
    "start": "node --env-file-if-exists=../.env src/index.ts",
    "listen": "node --env-file-if-exists=../.env scripts/listen.ts",
    "stripe:setup": "node --env-file-if-exists=../.env scripts/setup-stripe.ts",
    "typecheck": "tsc",
    "stripe:check-key": "node --env-file-if-exists=../.env.production.local scripts/check-key.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6"
  }
}
